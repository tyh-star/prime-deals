# Copy to .env for local development (`cp .env.example .env`).
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prime_deals
REDIS_URL=redis://localhost:6379/0

# Use a long random string in any shared environment: `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-please-32chars
JWT_EXPIRES_IN_SECONDS=7200

# Unpaid orders are cancelled after this many seconds and their stock is released.
ORDER_PAYMENT_TTL_SECONDS=900
# Safety-net sweep for overdue orders whose delayed job was lost.
ORDER_SWEEP_INTERVAL_MS=60000

UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173

# Bootstrap an admin account on startup (skipped if the username already exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Create a demo seller and a few approved products when the catalogue is empty.
SEED_DEMO=true
